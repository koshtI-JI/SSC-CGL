    "ScoringConfig": {
      "title": "ScoringConfig",
      "description": "Dynamic XP and SSC CGL marking formula managed by Super Admin.",
      "type": "object",
      "properties": {
        "pointsPerCorrect": { "type": "number" },
        "negativeMarks": { "type": "number" },
        "xpAttemptBase": { "type": "number" },
        "xpPerCorrect": { "type": "number" },
        "xpAccuracyThreshold": { "type": "number" },
        "xpAccuracyBonus": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "pointsPerCorrect",
        "negativeMarks",
        "xpAttemptBase",
        "xpPerCorrect",
        "xpAccuracyThreshold",
        "xpAccuracyBonus",
        "updatedAt"
      ]
    },
