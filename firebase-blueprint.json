        "questionHi": { "type": "string", "maxLength": 2000 },
        "optionsEn": { "type": "array" },
        "optionsHi": { "type": "array" },
        "correctIndex": { "type": "integer" },
        "explanationEn": { "type": "string", "maxLength": 3000 },
        "explanationHi": { "type": "string", "maxLength": 3000 },
        "shortTrick": { "type": "string", "maxLength": 1500 },
        "updatedBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "questionId",
        "subject",
        "topic",
        "difficulty",
        "questionEn",
        "optionsEn",
        "correctIndex",
        "updatedBy",
        "updatedAtMs",
        "updatedAt"
      ]
    }
  },
