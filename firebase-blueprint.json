      "required": [
        "appName",
        "cohortName",
        "defaultLanguage",
        "strictCameraDefault",
        "offlineAutoLogoutSec",
        "dailyAutoMockEnabled",
        "githubReportsEnabled",
        "aiTutorEnabled",
        "maintenanceBanner",
        "updatedAtMs",
        "updatedAt"
      ]
    },
